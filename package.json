{
  "name": "xinghe-ai-desktop",
  "version": "1.0.0",
  "description": "星核耀火 - AI视频创作平台桌面版",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json && node scripts/write-electron-pkg.cjs",
    "electron": "electron .",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"npm run electron:wait && electron --enable-logging --inspect=0 .\"",
    "electron:wait": "node scripts/wait-vite.cjs",
    "electron:diagnose": "node scripts/diagnose-electron.cjs",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.344.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0"
  }
}
